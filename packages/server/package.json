{
  "name": "@berry-agent/claw-server",
  "version": "0.5.0-alpha.3",
  "description": "Berry Claw server and CLI",
  "type": "module",
  "bin": {
    "berry-claw": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "web-dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "rm -rf dist && tsc",
    "start": "node dist/cli.js",
    "prepack": "node scripts/prepack.mjs",
    "postpack": "node scripts/postpack.mjs",
    "prepublishOnly": "npm run build",
    "test": "vitest run --maxWorkers=2 --exclude '**/integration*'",
    "test:integration": "vitest run --maxWorkers=1 src/__tests__/integration.test.ts"
  },
  "dependencies": {
    "@berry-agent/core": "^0.5.0-alpha.1",
    "@berry-agent/mcp": "^0.5.0-alpha.1",
    "@berry-agent/memory-file": "^0.5.0-alpha.1",
    "@berry-agent/models": "^0.5.0-alpha.1",
    "@berry-agent/observe": "^0.5.0-alpha.1",
    "@berry-agent/prompt-pack": "^0.5.0-alpha.1",
    "@berry-agent/runtime": "^0.5.0-alpha.1",
    "@berry-agent/safe": "^0.5.0-alpha.1",
    "@berry-agent/team": "^0.5.0-alpha.1",
    "@berry-agent/tools-common": "^0.5.0-alpha.1",
    "@berry-agent/claw-contracts": "^0.5.0-alpha.3",
    "@playwright/mcp": "0.0.73",
    "clawhub": "^0.12.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "nanoid": "^5.1.0",
    "playwright-core": "^1.59.1",
    "ws": "^8.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.0",
    "dotenv": "^17.4.1",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
