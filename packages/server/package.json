{
  "name": "@berry-agent/claw-server",
  "version": "0.5.0-alpha.3",
  "description": "Berry Claw server and CLI",
  "type": "module",
  "bin": {
    "berry-claw": "dist/cli.js"
  },
  "files": [
    "dist",
    "web-dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "rm -rf dist && tsc",
    "start": "node dist/cli.js",
    "prepack": "node scripts/prepack.mjs",
    "postpack": "node scripts/postpack.mjs",
    "prepublishOnly": "npm run build",
    "test": "vitest run --maxWorkers=2 --exclude '**/integration*'",
    "test:integration": "vitest run --maxWorkers=1 src/__tests__/integration.test.ts"
  },
  "dependencies": {
    "@berry-agent/claw-contracts": "^0.5.0-alpha.3",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "nanoid": "^5.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
